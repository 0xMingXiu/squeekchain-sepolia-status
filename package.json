{
  "name": "squeekchain-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Squeekchain Sepolia Quickstart (read-only) + status dashboard",
  "scripts": {
    "gen:abi": "node scripts/gen-abis.mjs",
    "setup": "./env.sh tsx setup.ts",
    "verify": "./env.sh tsx verify-run.ts",
    "read-core": "./env.sh tsx read-core.ts",
    "dashboard": "./env.sh tsx dashboard/server.ts",
    "typecheck": "tsc --noEmit",
    "verify:strict": "SQUEEK_STRICT=1 ./env.sh tsx verify-run.ts",
    "read-core:strict": "SQUEEK_STRICT=1 ./env.sh tsx read-core.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}